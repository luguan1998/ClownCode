# =============================================================================
# OpenClaude Environment Configuration
# =============================================================================
# OpenClaude talks to a single OpenAI-compatible endpoint by default.
# The recommended configuration path is settings.json:
#
#   ~/.claude/settings.json
#   {
#     "env": {
#       "ANTHROPIC_BASE_URL": "http://gateway.internal/v1",
#       "ANTHROPIC_AUTH_TOKEN": "your-token",
#       "ANTHROPIC_MODEL": "internal-model"
#     }
#   }
#
# Copy this file to .env only if your launcher loads .env files.
# =============================================================================

# -----------------------------------------------------------------------------
# Endpoint (required)
# -----------------------------------------------------------------------------
# ANTHROPIC_BASE_URL is preferred. If unset, OpenClaude falls back to
# OPENAI_BASE_URL and then OPENAI_API_BASE. There is no public default.
ANTHROPIC_BASE_URL=http://gateway.internal/v1
# OPENAI_BASE_URL=http://gateway.internal/v1
# OPENAI_API_BASE=http://gateway.internal/v1

# -----------------------------------------------------------------------------
# Credentials (one of)
# -----------------------------------------------------------------------------
# Resolution order: ANTHROPIC_AUTH_TOKEN -> ANTHROPIC_API_KEY -> OPENAI_API_KEY.
# A key is optional for local/intranet endpoints.
ANTHROPIC_AUTH_TOKEN=your-token
# ANTHROPIC_API_KEY=your-key
# OPENAI_API_KEY=your-key

# Custom auth header (optional; overrides the default Bearer header)
# OPENAI_AUTH_HEADER=x-api-key
# OPENAI_AUTH_HEADER_VALUE=your-key
# OPENAI_AUTH_SCHEME=raw

# -----------------------------------------------------------------------------
# Model (required in practice)
# -----------------------------------------------------------------------------
# Resolution order: OPENAI_MODEL -> ANTHROPIC_MODEL.
ANTHROPIC_MODEL=internal-model
# OPENAI_MODEL=internal-model

# Request format: chat_completions (default) or responses.
# OPENAI_API_FORMAT=chat_completions

# -----------------------------------------------------------------------------
# Transport (optional)
# -----------------------------------------------------------------------------
# Default: OpenAI-compatible shim.
# Set to 0 to use the native Anthropic SDK with ANTHROPIC_BASE_URL above.
# CLAUDE_CODE_USE_OPENAI=0

# Proxy / private CA (optional)
# HTTPS_PROXY=http://proxy.internal:8080
# NO_PROXY=localhost,127.0.0.1,.internal
# NODE_EXTRA_CA_CERTS=/path/to/internal-ca.pem

# Reduce nonessential traffic (optional)
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# DISABLE_TELEMETRY=1
